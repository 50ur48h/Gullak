# Copy this file to .env and fill in your values. Never commit .env.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# Optional: webhook ID from your PayPal app's Webhooks section (enables signature verification)
PAYPAL_WEBHOOK_ID=

# Meta Model API key (dev.meta.ai > API keys)
META_API_KEY=
# Optional overrides
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Optional backup: Google Gemini API key (aistudio.google.com). Used when Meta isn't reachable.
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (default gemini-3.5-flash; newer flash models are tried if it fails), AI_PROVIDER=auto|meta|gemini (default auto)

# Optional: public URL of your deployment (e.g. https://gullak.onrender.com). Used for PayPal return links + dashboard.
PUBLIC_URL=

# Timezone used for buddies' "awake hours"
TZ=Asia/Singapore

# DEMO_MODE=true makes bounties appear within a few minutes instead of hours (great for testing and the demo video)
DEMO_MODE=true

# Port for the dashboard + webhook server
PORT=3000
